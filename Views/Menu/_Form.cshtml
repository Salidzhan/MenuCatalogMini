@model MenuCatalogMini.Models.MenuItem

@{
    var cats = ViewBag.Categories as string[] ?? Array.Empty<string>();
}

<div asp-validation-summary="ModelOnly" class="validation"></div>

<div class="field">
    <label asp-for="Name"></label>
    <input asp-for="Name" placeholder="Име на ястието" />
    <span asp-validation-for="Name" class="validation"></span>
</div>

<div class="field">
    <label asp-for="Category"></label>
    <select asp-for="Category">
        <option value="">Изберете категория</option>
        @foreach (var c in cats)
        {
            <option value="@c">@c</option>
        }
    </select>
    <span asp-validation-for="Category" class="validation"></span>
</div>

<div class="two">
    <div class="field">
        <label asp-for="Price"></label>
        <input asp-for="Price" type="number" min="0.01" step="0.01" />
        <span asp-validation-for="Price" class="validation"></span>
    </div>

    <div class="field">
        <label asp-for="Grams"></label>
        <input asp-for="Grams" type="number" min="1" step="1" />
        <span asp-validation-for="Grams" class="validation"></span>
    </div>
</div>

<div class="field">
    <label asp-for="Description"></label>
    <textarea asp-for="Description" rows="4"
              placeholder="Опишете съставките или ястието"></textarea>
    <span asp-validation-for="Description" class="validation"></span>
</div>